# Evolution API v2 instance this backend talks to.
EVO_API_URL=http://localhost:8081
EVO_INSTANCE_NAME=bbwa
EVO_API_KEY=your_evolution_api_key_here

# Token the Android app sends as x-api-token. At least 16 characters.
# Avoid # and $ — Docker and Coolify truncate values at those.
AUTH_TOKEN=change_me_to_a_long_random_string

# Shared secret for the webhook path: POST /webhook/<secret>.
# Optional but strongly recommended — without it anyone who can reach this
# server can inject messages into your chat list.
WEBHOOK_SECRET=another_long_random_string

# Only needed if a browser calls this API. The Android client does not.
# CORS_ORIGIN=https://example.com

PORT=3000
